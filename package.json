{
  "type": "module",
  "dependencies": {
    "dotenv": "^17.2.4",
    "ink": "^7.0.1",
    "ink-file-picker": "^0.2.0",
    "mssql": "^11.0.1",
    "react": "^19.2.5",
    "tedious": "^19.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/mssql": "^9.1.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/typescript": "^0.4.29",
    "node": "^24.15.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:unit:app2": "playwright test tests/unit/application_02_*.spec.ts",
    "test:unit:app3": "playwright test tests/unit/application_03_*.spec.ts",
    "test:alpha1": "playwright test tests/unit/alpha1_*.spec.ts tests/app/alpha1_cli.spec.ts",
    "test:alpha1:db": "playwright test tests/app/alpha1_db.integration.spec.ts",
    "test:app2": "playwright test tests/unit/application_02_*.spec.ts tests/app/application_02_api_status.spec.ts tests/app/application_02_api_summary.spec.ts tests/app/application_02_cli.spec.ts tests/app/application_02_db_summary_cli.spec.ts",
    "test:app2:db": "playwright test tests/app/application_02_db.integration.spec.ts tests/app/application_02_export.integration.spec.ts",
    "test:app3": "playwright test tests/unit/application_03_*.spec.ts tests/app/application_03_cli.spec.ts",
    "ui:app1": "node --experimental-strip-types Application/01/main.ts --title \"Ink Demo\"",
    "ui:app2": "node --import tsx Application/02/ui.ts",
    "ui:app3": "node --import tsx Application/03/picker.tsx"
  }
}
